{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ravidvr/mietspiegel-digitization/main/docs/schema.json",
  "title": "Mietspiegel Digitization — Unified Data Schema",
  "description": "JSON Schema for validating extracted German Mietspiegel (rent index) data across all cities.",
  "version": "1.0.0",
  "type": "object",
  "required": ["meta", "city", "source", "matrix"],
  "properties": {
    "meta": {
      "type": "object",
      "description": "Metadata about extraction quality and provenance",
      "required": ["schema_version", "extracted_at", "quality"],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semver of this schema"
        },
        "extracted_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 timestamp of extraction"
        },
        "extracted_by": {
          "type": "string",
          "description": "Tool used for extraction (e.g. camelot-py, manual)"
        },
        "extraction_notes": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ],
          "description": "Free-text notes about extraction"
        },
        "quality": {
          "type": "object",
          "required": ["status", "confidence", "issues"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["raw", "validated", "flagged"],
              "description": "Validation status"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "location", "detail"],
                "properties": {
                  "type": { "type": "string" },
                  "location": { "type": "string" },
                  "detail": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "city": {
      "type": "object",
      "description": "City identification and location",
      "required": ["name", "slug", "state", "coordinates"],
      "properties": {
        "name": {
          "type": "string",
          "description": "City name in German (e.g. München)"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "URL-safe id (lowercase, no diacritics)"
        },
        "state": {
          "type": "string",
          "description": "Bundesland"
        },
        "region": {
          "type": "string",
          "description": "Optional metropolitan region"
        },
        "population": {
          "type": "integer",
          "minimum": 0
        },
        "coordinates": {
          "type": "object",
          "required": ["lat", "lng"],
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lng": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "description": "Source document and legal validity",
      "required": ["title", "type", "year", "effective_from", "publisher", "url"],
      "properties": {
        "title": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["qualifiziert", "einfach", "ortsueblich"]
        },
        "year": { "type": "integer", "minimum": 2000 },
        "effective_from": {
          "type": "string",
          "format": "date",
          "description": "Date the Mietspiegel takes legal effect"
        },
        "effective_until": {
          "oneOf": [
            { "type": "string", "format": "date" },
            { "type": "null" }
          ],
          "description": "Expiry date (typically 2 years after effective_from)"
        },
        "publisher": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "pdf_url": {
          "oneOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        },
        "local_pdf": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "pages": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "retrieved_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        }
      }
    },
    "matrix": {
      "type": "object",
      "description": "The 3-dimensional Mietspiegel data matrix",
      "required": ["lage_categories", "bauperiods", "size_groups", "values"],
      "properties": {
        "lage_categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "aliases"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "aliases": {
                "type": "array",
                "items": { "type": "string" }
              },
              "description": { "type": "string" },
              "extra": {
                "type": "object",
                "properties": {
                  "normalized_from": { "type": "string" },
                  "normalization_note": { "type": "string" }
                }
              }
            }
          }
        },
        "bauperiods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "range": {
                "type": "object",
                "required": ["min", "max"],
                "properties": {
                  "min": {
                    "oneOf": [
                      { "type": "integer" },
                      { "type": "null" }
                    ]
                  },
                  "max": {
                    "oneOf": [
                      { "type": "integer" },
                      { "type": "null" }
                    ]
                  }
                }
              }
            }
          }
        },
        "size_groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "range": {
                "type": "object",
                "required": ["min", "max"],
                "properties": {
                  "min": {
                    "oneOf": [
                      { "type": "number" },
                      { "type": "null" }
                    ]
                  },
                  "max": {
                    "oneOf": [
                      { "type": "number" },
                      { "type": "null" }
                    ]
                  }
                }
              }
            }
          }
        },
        "values": {
          "type": "array",
          "description": "Every cell in the 3D matrix as a flat object",
          "items": {
            "type": "object",
            "required": ["lage_id", "bauperiod_id", "size_id", "value"],
            "properties": {
              "lage_id": { "type": "string" },
              "bauperiod_id": { "type": "string" },
              "size_id": { "type": "string" },
              "value": {
                "type": "object",
                "required": ["untere_spanne", "obere_spanne", "mittelwert"],
                "properties": {
                  "untere_spanne": {
                    "oneOf": [
                      { "type": "number", "minimum": 0 },
                      { "type": "null" }
                    ]
                  },
                  "obere_spanne": {
                    "oneOf": [
                      { "type": "number", "minimum": 0 },
                      { "type": "null" }
                    ]
                  },
                  "mittelwert": {
                    "oneOf": [
                      { "type": "number", "minimum": 0 },
                      { "type": "null" }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
